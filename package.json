{
  "name": "documents-blogsite",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "cache:clear": "node -e \"const fs=require('node:fs'); for(const p of ['.astro/data-store.json','node_modules/.astro/data-store.json']) fs.rmSync(p,{force:true})\"",
    "reset": "astro dev stop",
    "dev": "astro sync --force && astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.2.10",
    "sharp": "^0.35.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
