---
import { Image } from "astro:assets";
import blogHeader from "../assets/blog-header.JPG";
import menuIcon from "../assets/menu.svg";
import arrowIcon from "../assets/arrow_back.svg";
import { SITE_TITLE } from "../consts";
import SideMenu from "./SideMenu.astro";
interface Props {
	compact?: boolean;
	title?: string;
}
const { compact = false, title = "" } = Astro.props;
---

<header class:list={["site-header", { compact }]}>
	<SideMenu />
	<div class="header-inner">
		<Image class="header-art" src={blogHeader} alt="" aria-hidden="true" />
		<button
			class="menu-toggle"
			type="button"
			aria-label="Open navigation"
			aria-expanded="false"
			aria-controls="site-menu"
			><img src={menuIcon.src} alt="" aria-hidden="true"/></button
		>
		{
			compact && (
				<a class="back-link" href="/blog" aria-label="Back to the blog">
					<img src={arrowIcon.src} />
				</a>
			)
		}
		<a class="site-title" href="/"
			>{title !== "" ? title : SITE_TITLE}</a
		>
	</div>
</header>
<script>
	const setupMenu = () => {
		const menu = document.querySelector<HTMLElement>("#site-menu");
		const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
		const close = document.querySelector<HTMLButtonElement>(".menu-close");
		if (!menu || !toggle || !close || menu.dataset.ready) return;
		menu.dataset.ready = "true";
		const setOpen = (open: boolean) => {
			menu.dataset.open = String(open);
			menu.setAttribute("aria-hidden", String(!open));
			toggle.setAttribute("aria-expanded", String(open));
			document.body.classList.toggle("menu-open", open);
			(open ? close : toggle).focus();
		};
		toggle.addEventListener("click", () => setOpen(true));
		close.addEventListener("click", () => setOpen(false));
		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && menu.dataset.open === "true")
				setOpen(false);
		});
	};
	setupMenu();
	document.addEventListener("astro:page-load", setupMenu);
</script>
<style>
	.site-header {
		position: relative;
		min-height: var(--header-height);
		background: var(--color-blue);
		color: white;
		overflow: hidden;
	}
	.header-inner {
		position: relative;
		min-height: inherit;
		padding: var(--space-4);
		display: flex;
		align-items: flex-start;
	}
	.header-art {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
		pointer-events: none;
	}
	.menu-toggle {
		position: relative;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0.6rem;
		border: 0;
		background: transparent;
		color: white;
		cursor: pointer;
	}
	.menu-toggle img {
		max-width: 37px;
		width: 37px;
		height: 37px;
	}
	.site-title {
		position: absolute;
		left: var(--space-4);
		bottom: var(--space-4);
		max-width: 19rem;
		color: white;
		font-family: var(--font-title);
		font-size: var(--font-title-size);
		line-height: 0.95;
		text-decoration: none;
		letter-spacing: 0.02em;
	}
	.back-link {
		position: relative;
		margin-top: 0.15rem;
		color: white;
		font-size: 2.25rem;
		line-height: 1;
		text-decoration: none;
	}
	.compact {
		min-height: 5rem;
	}
	.compact .header-inner {
		width: 100%;
		max-width: var(--content-max);
		margin-inline: auto;
		padding-inline: var(--space-5);
	}
	.compact .header-art {
		inset: 0 0 auto auto;
		height: 250%;
		width: auto;
		object-position: right top;
	}
	.compact .menu-toggle {
		display: none;
	}
	.compact .site-title {
		left: 4.25rem;
		bottom: 1.55rem;
		max-width: calc(100% - 9rem);
		font-size: 2.1rem;
		white-space: nowrap;
	}
	/**space beside centered <main>
	+ .surface’s internal padding
	= left edge of .post-grid */
	@media (min-width: 48rem) {
		.header-inner {
			padding-inline: 1.25rem;
		}
		.compact .header-inner {
			padding-inline: var(--space-5);
		}
		.site-header:not(.compact) .site-title {
			left: max(
				var(--space-4),
				calc((100% - var(--content-max)) / 2 + var(--space-4))
			);
			width: 22rem;
			max-width: calc(100% - 2 * var(--space-4));
		}
	}
	@media (min-width: 64rem) {
		.site-header:not(.compact) {
			min-height: 27rem;
		}
		.site-header:not(.compact) .header-art {
			left: 50%;
			right: auto;
			width: calc(100% - (2 * var(--space-4)));
			max-width: calc(
				var(--content-max-desktop) - (2 * var(--space-4))
			);
			transform: translateX(-50%);
		}
		.header-inner {
			padding-inline: 1.25rem;
		}
		.compact .header-inner {
			max-width: var(--content-max-desktop);
			padding-inline: var(--space-5);
		}
		.site-header:not(.compact) .site-title {
			left: max(
				var(--space-4),
				calc((100% - var(--content-max-desktop)) / 2 + var(--space-4))
			);
			bottom: 4.5rem;
			width: 45rem;
			max-width: calc(100% - 2 * var(--space-4));
		}
	}	
</style>
