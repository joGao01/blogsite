---
import FormattedDate from "./FormattedDate.astro";
interface Props {
	image?: string;
	title: string;
	description: string;
	pubDate: Date;
	href: string;
}
const { image, title, description, pubDate, href } = Astro.props;
---

<article class="post-card">
	<a class="image-link" href={href} aria-label={`Read ${title}`}
		>{
			image ? (
				<img src={image} width="680" height="680" alt="" loading="lazy" class="fade-image" />
			) : (
				<span class="image-placeholder" aria-hidden="true" />
			)
		}</a
	>
	<div class="post-card-body">
		<h2><a href={href}>{title}</a></h2>
		<p>{description}</p>
		<FormattedDate
			date={pubDate}
		/>
	</div>
</article>
<script>
	// TODO: fade in isn't working yet
	document.querySelectorAll<HTMLImageElement>(".fade-image").forEach((image) => {
		const reveal = () => image.classList.add("is-loaded");

		if (image.complete) {
			reveal();
		} else {
			image.addEventListener("load", reveal, { once: true });
		}
	});
</script>
<style>
	.post-card {
		--card-rotation: -1deg;
		--card-translate-y: 0;
		--card-shadow: var(--shadow);

		position: relative;
		display: flex;
		flex-direction: column;
		width: 100%;
		height: 100%;
		padding: var(--space-3);
		color: var(--color-text);
		background: var(--color-paper);
		box-shadow: var(--card-shadow);
		transform: translateY(var(--card-translate-y));
		transition:
			transform 200ms ease,
			box-shadow 200ms ease;
	}

	/* Alternate the rotation direction between cards. */
	:global(.post-grid > li:nth-child(even)) .post-card {
		--card-rotation: 1deg;
	}

	/* Include focus-within for keyboard navigation. */
	.post-card:focus-within {
		--card-translate-y: -0.4rem;
		--card-shadow: 0 0.75rem 1.25rem rgb(24 42 78 / 0.3);

		z-index: 1;
		transform:
			translateY(var(--card-translate-y))
			rotate(var(--card-rotation));
	}

	/* Only apply hover effects on devices that support hovering. */
	@media (hover: hover) {
		.post-card:hover {
			--card-translate-y: -0.4rem;
			--card-shadow: 0 0.75rem 1.25rem rgb(24 42 78 / 0.3);

			z-index: 1;
			transform:
				translateY(var(--card-translate-y))
				rotate(var(--card-rotation));
		}
	}
	.post-card-body {
		display: flex;
		flex: 1;
		flex-direction: column;
	}
	.image-link {
		position: relative;
		display: block;
		aspect-ratio: 1;
		overflow: hidden;
		background: var(--color-image-placeholder);
	}
	.image-link :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;	
	}
	.image-link::after {
		position: absolute;
		z-index: 1;
		inset: 0;
		content: "";
		pointer-events: none;
		box-shadow: inset 0 0 1rem 0 rgb(24 42 78/0.35);
	}
	.image-placeholder {
		display: block;
		width: 100%;
		height: 100%;
		background: var(--color-image-placeholder);
	}
	.image-link :global(.fade-image) {
		opacity: 0;
		transition: opacity 1000ms ease;
	}
	.image-link :global(.fade-image.is-loaded) {
		opacity: 1;
	}
	h2 {
		margin: var(--space-3) 0 var(--space-2);
		font-family: var(--font-post-title);
		font-size: 1.75rem;
		font-weight: 400;
		line-height: 1.15;
	}
	h2 a {
		color: var(--color-ink);
		text-decoration: none;
	}
	p {
		margin: 0 0 var(--space-2);
		height: calc(3 * 1.25em);
		overflow: hidden;
		font-size: var(--font-body-size);
		line-height: 1.25;
		-webkit-mask-image: linear-gradient(to bottom, #000 70%, transparent);
		mask-image: linear-gradient(to bottom, #000 70%, transparent);
	}
	.post-card-body :global(time) {
		display: block;
		margin-top: auto;
		color: var(--color-text-muted);
		text-align: right;
	}
	/*@media (prefers-reduced-motion: reduce) {
		.post-card,
		.post-card:hover,
		.post-card:focus-within {
			transition: none;
			transform: none;
		}

		.image-link :global(.fade-image) {
			opacity: 1;
			transition: none;
		}
	}*/
</style>
