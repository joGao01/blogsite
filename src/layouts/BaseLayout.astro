---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
interface Props {
	title?: string;
	description?: string;
	compactHeader?: boolean;
}
const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	compactHeader = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head><BaseHead title={title} description={description} /></head><body
		><Header compact={compactHeader} title={title}/><main><slot /></main><Footer /></body>
</html>
