---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import BaseLayout from "./BaseLayout.astro";
import { SITE_TITLE } from "../consts";
type Props = CollectionEntry<"blog">["data"];
const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<BaseLayout title={SITE_TITLE} description={description} compactHeader>
	<article class="blog-post">
		<header class="post-heading">
			<h1>{title}</h1><div class="post-meta">
				<span>From: Jo<br />To: You</span><FormattedDate date={pubDate} />
			</div>{
				updatedDate && (
					<p>
						Updated <FormattedDate date={updatedDate} />
					</p>
				)
			}
		</header>
		{
			heroImage && (
				<figure>
					<>
						<img src={heroImage} width="900" height="600" alt="" />
						<figcaption>{description}</figcaption>
					</>
				</figure>
			)
		}
		<div class="prose"><slot /></div><p class="signoff">Best,<br />Jo</p>
	</article>
</BaseLayout>
<style>
	.blog-post {
		padding: var(--space-5);
		background: var(--color-blue-light);
		min-height: 100vh;
	}
	.post-heading {
		margin-bottom: var(--space-5);
	}
	h1 {
		margin: 0 0 var(--space-4);
		color: var(--color-ink);
		font-family: var(--font-post-title);
		font-size: clamp(2rem, 9vw, 2.8rem);
		font-weight: 400;
		line-height: 1.1;
	}
	.post-meta {
		display: flex;
		justify-content: space-between;
		align-items: end;
		gap: var(--space-3);
		font-size: var(--font-body-size);
	}
	figure {
		margin: 0 0 var(--space-4);
		padding: var(--space-3);
		background: white;
		box-shadow: var(--shadow);
	}
	figure :global(img) {
		width: 100%;
		border-radius: 0;
	}
	figcaption {
		padding-top: var(--space-2);
		text-align: center;
		font-size: var(--font-body-size);
	}
	.prose {
		line-height: 1.35;
		font-size: var(--font-body-size);
	}
	.prose :global(h2) {
		color: var(--color-text);
		font-family: var(--font-heading);
		font-weight: 700;
	}
	.prose :global(img) {
		padding: var(--space-3);
		background: white;
		border-radius: 0;
		box-shadow: var(--shadow);
	}
	.signoff {
		margin-top: var(--space-5);
	}
</style>
