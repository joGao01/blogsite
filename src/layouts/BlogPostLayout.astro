---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import BaseLayout from "./BaseLayout.astro";
import closeButton from "../assets/close-white.svg";
import { SITE_TITLE } from "../consts";
type Props = CollectionEntry<"blog">["data"];
const { title, description, pubDate, updatedDate } = Astro.props;
---

<script>
	const dialog = document.querySelector<HTMLDialogElement>(".image-lightbox");
	const image = dialog?.querySelector<HTMLImageElement>(".lightbox-image");
	const caption = dialog?.querySelector<HTMLElement>(".lightbox-caption");
	const scrollLockClass = "lightbox-open";

	dialog?.addEventListener("close", () => {
		document.documentElement.classList.remove(scrollLockClass);
	});

	document.addEventListener("click", (event) => {
		const target = event.target as HTMLElement;

		const postImage = target.closest<HTMLImageElement>(".post-image");
		if (postImage && dialog && image && caption) {
			image.src = postImage.src;
			image.alt = postImage.alt;

			caption.textContent =
				postImage.closest("figure")?.querySelector("figcaption")?.textContent ??
				"";

			document.documentElement.classList.add(scrollLockClass);
			dialog.showModal();
			return;
		}

		if (
			target.closest(".lightbox-close") ||
			(target === dialog && dialog.open)
		) {
			dialog?.close();
		}
	});
</script>

<BaseLayout title={SITE_TITLE} description={description} compactHeader>
	<article class="blog-post">
		<header class="post-heading">
			<h1>{title}</h1><div class="post-meta">
				<span>From: Jo<br />To: You</span><FormattedDate date={pubDate} />
			</div>{
				updatedDate && (
					<p>
						Updated <FormattedDate date={updatedDate} />
					</p>
				)
			}
		</header>
		<div class="prose"><slot /></div><p class="signoff">Best,<br />Jo</p>
	</article>
	<dialog class="image-lightbox">
		<button class="lightbox-close" type="button" aria-label="Close image"
			><img src={closeButton.src}/></button
		>
		<img class="lightbox-image" alt="" />
		<p class="lightbox-caption"></p>
	</dialog>
</BaseLayout>
<style>
	:global(html.lightbox-open) {
		overflow: hidden;
	}

	.blog-post {
		padding: var(--space-4);
		background: var(--color-blue-light);
		min-height: 100vh;
	}
	.post-heading {
		margin-bottom: var(--space-5);
	}
	h1 {
		margin: 0 0 var(--space-4);
		color: var(--color-ink);
		font-family: var(--font-post-title);
		font-size: clamp(2rem, 9vw, 2.8rem);
		font-weight: 400;
		line-height: 1.1;
	}
	.post-meta {
		display: flex;
		justify-content: space-between;
		align-items: end;
		gap: var(--space-3);
		font-size: var(--font-body-size);
	}
	.prose {
		line-height: 1.35;
		font-size: var(--font-body-size);
	}
	.prose :global(h2) {
		color: var(--color-text);
		font-family: var(--font-heading);
		font-weight: 700;
	}
	.prose :global(figure) {
		width: 100%;
		max-width: 35rem;
		margin-inline: auto;
		padding: var(--space-2);
		background: var(--color-paper);
		border-radius: 0;
		box-shadow: var(--shadow);
	}
	.prose :global(.post-figure figcaption) {
		padding-top: var(--space-2);
		text-align: center;
		font-size: var(--font-body-size);
	}
	.prose :global(img:hover) {
		cursor: pointer;
	}
	.prose :global(button) {
		background: transparent;
    border: 0;
	}
	dialog button {
		display: block;
		margin-left: auto;
		border: 0;
		background: transparent;
	}
	dialog button:hover {
		cursor: pointer;
	}
	.signoff {
		margin-top: var(--space-5);
		font-size: var(--font-body-size);
	}
	.image-lightbox {
		width: fit-content;
		height: fit-content;
		padding: 0;
		border: 0;
		background: transparent;
	}
	.image-lightbox::backdrop {
		background: rgb(0 0 0 / 0.8);
	}
	.lightbox-image {
		width: 100%;
		max-height: 80vh;
		object-fit: contain;
	}
	.lightbox-close {
		/*position: absolute;*/
		top: var(--space-2);
		right: var(--space-2);
		z-index: 1;
	}
	.lightbox-caption {
		color: var(--color-paper)
	}
	.lightbox-caption:empty {
		display: none;
	} 
	@media (min-width: 48rem) {
		/* larger padding for tablet/desktop screens*/
		.blog-post {
			padding: var(--space-5);
		}
		.prose :global(figure) {
			padding: var(--space-3);
		}
	}
</style>
