---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Pagination from "../../components/Pagination.astro";
import PostCard from "../../components/PostCard.astro";
import { POSTS_PER_PAGE, SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogPostLayout from "../../layouts/BlogPostLayout.astro";
type ListingProps = {
	kind: "listing";
	posts: CollectionEntry<"blog">[];
	currentPage: number;
	totalPages: number;
};
type PostProps = { kind: "post"; post: CollectionEntry<"blog"> };
export async function getStaticPaths() {
	const posts = (await getCollection("blog")).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);
	const listings = Array.from(
		{ length: Math.max(0, totalPages - 1) },
		(_, index) => {
			const currentPage = index + 2;
			return {
				params: { slug: String(currentPage) },
				props: {
					kind: "listing",
					posts: posts.slice(
						(currentPage - 1) * POSTS_PER_PAGE,
						currentPage * POSTS_PER_PAGE,
					),
					currentPage,
					totalPages,
				} satisfies ListingProps,
			};
		},
	);
	const articles = posts.map((post) => ({
		params: { slug: post.id },
		props: { kind: "post", post } satisfies PostProps,
	}));
	return [...listings, ...articles];
}
const props = Astro.props as ListingProps | PostProps;
const rendered = props.kind === "post" ? await render(props.post) : null;
const Content = rendered?.Content;
---

{
	props.kind === "listing" ? (
		<BaseLayout
			title={SITE_TITLE}
			description={SITE_DESCRIPTION}
		>
			<section class="surface">
				<>
					<ul class="post-grid">
						{props.posts.map((post) => (
							<li>
								<PostCard
									image={post.data.heroImage}
									title={post.data.title}
									description={post.data.description}
									pubDate={post.data.pubDate}
									href={`/blog/${post.id}`}
								/>
							</li>
						))}
					</ul>
					<Pagination
						currentPage={props.currentPage}
						totalPages={props.totalPages}
					/>
				</>
			</section>
		</BaseLayout>
	) : Content ? (
		<BlogPostLayout {...props.post.data}>
			<Content />
		</BlogPostLayout>
	) : null
}
